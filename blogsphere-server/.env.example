# ------------------------------------------------------------------
# BlogSphere server configuration
# Copy this file to `.env` (same folder) and fill in your own values.
# NEVER commit your real .env file - it is already in .gitignore.
# ------------------------------------------------------------------

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Public address of the website on your own domain (used in /sitemap.xml links). Defaults to CLIENT_URL.
# SITE_URL=https://www.yourdomain.com

# MongoDB connection string - REQUIRED.
# MongoDB Atlas: replace <db_password> with the password of the `blogsphere_app` database user
# (Atlas > Database Access). URL-encode special characters (e.g. @ -> %40). Never commit the real value.
MONGODB_URI=mongodb+srv://blogsphere_app:<db_password>@blogsphere-cluster.xyvrcgg.mongodb.net/blogsphere?retryWrites=true&w=majority
# Local MongoDB alternative (MongoDB Community Server running on your machine):
# MONGODB_URI=mongodb://127.0.0.1:27017/blogsphere
# Optional: DNS servers for the mongodb+srv lookup if your network blocks it (querySrv ECONNREFUSED)
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Secrets & Expiration (use a long random string in production)
JWT_SECRET=supersecret_blogsphere_jwt_key_development_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Admin account created by `npm run seed`.
# These are DEVELOPMENT defaults only - change the password before using a shared or online database.
ADMIN_NAME=BlogSphere Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@blogsphere.local
ADMIN_PASSWORD=AdminPassword123!

# Optional: password given to the sample writer accounts created by `npm run seed`.
# Leave empty to give them a random password (they can still be used to display content).
SEED_WRITER_PASSWORD=

# Optional: email address that receives contact-form notifications (messages are always stored in MongoDB)
CONTACT_EMAIL=

# Email Dispatcher Configuration (Optional: SMTP / Console logger)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@blogsphere.local
FROM_NAME=BlogSphere
