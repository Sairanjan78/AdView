# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/blogsphere

# JWT Secrets & Expiration
JWT_SECRET=supersecret_blogsphere_jwt_key_development_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email Dispatcher Configuration (Optional: SMTP / Console logger)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@blogsphere.local
FROM_NAME=BlogSphere
