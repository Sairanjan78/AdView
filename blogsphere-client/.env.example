# Copy this file to `.env` in blogsphere-client/ (optional for local development).
# Values are baked in at build time: restart `npm start` / re-run `npm run build` after changing them.

# Base URL of the BlogSphere API
REACT_APP_API_URL=http://localhost:5000/api/v1

# Optional: "Continue with Google" on the sign-in page. OAuth Web client ID from Google Cloud Console
# (same value as GOOGLE_CLIENT_ID on the server). Leave empty to hide the button. See the root README.
REACT_APP_GOOGLE_CLIENT_ID=

# Public address of the website on your own domain (canonical + Open Graph links)
# REACT_APP_SITE_URL=https://www.yourdomain.com

# Public contact email shown on Contact / Privacy / Terms pages
# REACT_APP_CONTACT_EMAIL=hello@yourdomain.com

# Optional: your social profiles (footer icons only show for the ones you set)
# REACT_APP_SOCIAL_TWITTER=https://x.com/yourhandle
# REACT_APP_SOCIAL_INSTAGRAM=https://instagram.com/yourhandle
# REACT_APP_SOCIAL_LINKEDIN=https://linkedin.com/in/yourhandle

# Public URL of the sitemap (written into build/robots.txt by `npm run build`).
# Defaults to <origin of REACT_APP_API_URL>/sitemap.xml when that is not localhost.
# REACT_APP_SITEMAP_URL=https://api.yourdomain.com/sitemap.xml

# Google AdSense - leave empty until your site is approved. Nothing is loaded while empty.
# Publisher id from AdSense > Account > Account information (starts with ca-pub-)
REACT_APP_ADSENSE_CLIENT=
# Ad unit ids (AdSense > Ads > By ad unit > Display ads; the number in data-ad-slot)
REACT_APP_ADSENSE_SLOT_ARTICLE_TOP=
REACT_APP_ADSENSE_SLOT_ARTICLE_END=
REACT_APP_ADSENSE_SLOT_HOME=
